# Virtual environments and Python cache artifacts
.venv/
__pycache__/
*.py[cod]

# Existing QR toolkit generated artifacts
qr_pdf_toolkit/.venv/
qr_pdf_toolkit/__pycache__/
qr_pdf_toolkit/qr_crops/
qr_pdf_toolkit/*_report.json

# Generated analysis outputs and local test data
work/
outputs/*_diagnosis/
outputs/*_recheck*/
outputs/*_test_reports/
outputs/report_diagnosis_overlays/
outputs/real_pdf_recheck/
outputs/phone_photo_diagnosis/
outputs/copy_pdf_diagnosis/
outputs/merged_pdf_diagnosis/
outputs/merged_pdf_page_only_recheck/
outputs/copy_pdf_recheck_v012/
outputs/same_phone_test_reports/

# Local app/session folders
.agents/
.codex/
.claude/
*.log
*.tsbuildinfo

# Keep reusable deliverable toolkits tracked
!outputs/
!outputs/scanner_noise_fingerprint_toolkit/
!outputs/scanner_noise_fingerprint_toolkit/**
!outputs/same_phone_pdf_check_toolkit/
!outputs/same_phone_pdf_check_toolkit/**
backend/data/
license-data/

# Downloaded local AI runtime and model weights
backend/models/
backend/runtime/
# Signature detector weight (large binary; fetch per weights/README.md)
tools/signature_analysis/weights/*.pt
# Signature benchmark outputs
tools/signature_analysis/benchmark_out/

# Landing-page flight: intermediate frames only. The encoded clip, its poster
# and the per-stop stills under frontend/public/flight/ are build products that
# ship with the page, so they stay tracked -- re-render with
# tools/flight/render_flight.py.
tmp/flight-frames/
tmp/flight-probe/
.gstack/

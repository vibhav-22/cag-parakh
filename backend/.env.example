# Optional OpenAI-compatible visual language model service.
# Keep disabled until the model server is running.
VLM_ENABLED=0
VLM_BASE_URL=http://127.0.0.1:8080/v1
VLM_MODEL=Qwen3-VL-4B-Instruct
VLM_API_KEY=
VLM_TIMEOUT_SECONDS=240
VLM_MAX_CONCURRENCY=1
VLM_JSON_MODE=1
VLM_OCR_MAX_PAGES=80
VLM_OCR_DPI=120
VLM_OCR_LANGUAGES=eng

# Non-loopback endpoints are blocked by default because document page images
# and extracted text are sent to the configured VLM service.
VLM_ALLOW_REMOTE=0
